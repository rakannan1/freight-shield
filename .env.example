# FMCSA QCMobile web key (free, register at the FMCSA developer site)
FMCSA_WEB_KEY=

# Supabase (anon key is safe for the browser; the service role key is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed app (used for login and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API (alert summaries; alerts still send without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Email via Resend (alerts are logged to the console when unset)
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Stripe. Billing is enforced only when both STRIPE_SECRET_KEY and STRIPE_PRICE_ID are set.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Shared secret for the daily cron route (Vercel sends it as a Bearer token)
CRON_SECRET=

# Set to "mock" to run against built-in fixtures instead of the live FMCSA API
FMCSA_PROVIDER=live

# Optional insurance filings (Motus open data). Leave unset until you've run scripts/check-fmcsa.mjs and confirmed columns.
INSURANCE_SOURCE=
MOTUS_INSUR_DATASET=
SOCRATA_APP_TOKEN=
